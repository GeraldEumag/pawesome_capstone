# Pawesome Frontend Environment Variables
# These are build-time values baked into the static bundle

# Base URL for the Laravel backend API
# Use a relative path if serving SPA + API from the same origin (recommended for XAMPP)
# Or use an absolute URL if the frontend and backend are on different origins
VITE_API_BASE_URL=/api

# Example for separate origins (cross-origin):
# VITE_API_BASE_URL=http://localhost:8000/api
