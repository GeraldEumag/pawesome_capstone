# Pawesome Frontend Environment Variables
# These are build-time values baked into the static bundle

# Base URL for the Laravel backend API.
# Set the final API URL in Vercel project environment settings before building.
VITE_API_BASE_URL=https://api.example.com/api

# Local development examples:
# VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=http://localhost:8000/api
